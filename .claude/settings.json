{
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log --oneline -10)"
    ],
    "ask": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run build)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(supabase migration *)",
      "Bash(npx supabase migration *)",
      "Bash(supabase link*)",
      "Bash(npx supabase link*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(type *.env*)",
      "Bash(grep * .env*)",
      "Bash(printenv*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel env pull*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(supabase db reset*)",
      "Bash(npx supabase db reset*)",
      "Bash(supabase db push --linked*)",
      "Bash(supabase projects delete*)",
      "Bash(npx prisma*)",
      "Bash(prisma *)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel deploy --prod*)",
      "Bash(vercel remove*)",
      "Bash(vercel rm *)"
    ]
  }
}
